# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# EMAIL DISPATCH SERVICE CONFIGURATION
# ==============================================================================
# The application supports multiple dedicated email API providers and SMTP servers:
#
# Option A: Dedicated Email API (Recommended - Resend, SendGrid, Brevo)
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# RESEND_FROM="Noetic Scholar <onboarding@resend.dev>"
# SENDGRID_API_KEY="SG.xxxxxxxxxxxx"
# SENDGRID_FROM="verify@yourdomain.com"
# BREVO_API_KEY="xkeysib-xxxxxxxxxxxx"
#
# Option B: Direct SMTP or Gmail App Password
# For Gmail, create an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
#
# For custom SMTP providers (Amazon SES, Mailgun, Postmark, Mailtrap, etc.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM=""
#
# Zero-Configuration Fallback:
# If no credentials are provided above, Noetic automatically spins up an
# Ethereal Real-Time Mailbox or instant test code, complete with live inbox
# preview links so registration verification is always 100% reliable!

